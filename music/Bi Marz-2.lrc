آه بی‌مرز
بی‌مرز
تو میای از دور
ولی نزدیک‌تر از نفسی
شب افتاده روی شهر
نور می‌رقصه توی بارون
منو می‌بره نگاهت
جایی بین خواب و خیابون
نه اسمشو می‌دونم
نه راه برگشت دارم
تو یه حال عجیبی
که نمی‌خوام کم بیارم
یه چیزی توی صدات
که دلمو می‌بره آروم
یه چیزی توی چشات
که می‌کشه منو بیرون
بی‌مرز دوست دارم
بی‌مرز می‌خوامت
تو هر جای دنیا
دلم میاد سمتت
بی‌مرز دوست دارم
بی‌مرز می‌خوامت
نه فاصله می‌فهمه
نه دنیا
نه ساعت
آه آه آه
بی‌مرز
آه آه آه
بی‌مرز
تو میای، دل میره
شب دوباره می‌گیره
اسم تو رو از لبم
باد آروم می‌شنوه
تو میای، دل میره
همه چی رنگ می‌گیره
بی‌مرز، بی‌مرز
عشق از اینجا می‌گذره
روی موج صداتم
مثل دریا بی‌قرارم
همه شهر خوابیده
من هنوز بیدارم
تو یه حس تازه‌ای
مثل اولین سفر
با تو حتی سکوت هم
می‌زنه حرف قشنگ‌تر
یه چیزی توی صدات
که دلمو می‌بره آروم
یه چیزی توی چشات
که می‌کشه منو بیرون
بی‌مرز دوست دارم
بی‌مرز می‌خوامت
تو هر جای دنیا
دلم میاد سمتت
بی‌مرز دوست دارم
بی‌مرز می‌خوامت
نه فاصله می‌فهمه
نه دنیا
نه ساعت
اگه دنیا یه لحظه وایسه
من تو رو انتخاب می‌کنم
اگه راهی نمونه برامون
باز با تو ادامه می‌دم
نه به فردا فکر می‌کنم
نه به دیروزای دور
تو همین لحظه بمون
تو همین ضرب نور
بی‌مرز دوست دارم
بی‌مرز می‌خوامت
تو هر جای دنیا
دلم میاد سمتت
