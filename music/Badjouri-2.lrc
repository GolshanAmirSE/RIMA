بدجوری
بدجوری
گیره دلم به تو
بدجوری
اسم تو افتاده توی جونم
من قبل تو
انگار یه چیزی کم داشتم
یه راه نرفته
یه حسی که نمی‌شناختم
تو اومدی
و همه چی آروم شد
مثل بارون
روی خیابون بعد گرما
هرجا میرم
رد تو باهامه
هر چی می‌بینم
منو یادت میندازه
انگار دنیا
از وقتی تو رو دیدم
یه رنگ تازه پیدا کرده
نه می‌خوام از این حس فرار کنم
نه می‌خوام عوض بشه
هرچی بیشتر می‌گذره
دلم بیشتر سمت تو میره
بدجوری
بدجوری دوستت دارمت
هر روز بیشتر از دیروز
دلم می‌خوادت
بدجوری
بدجوری با منی
مثل نوری که هنوز
توی شبام جاریه
بدجوری
بدجوری عاشقتم
مثل موجی که می‌رسه
به ساحل همیشگی
آه آه آه
بدجوری
آه آه آه
دلم گیره تو
آه آه آه
بدجوری
آه آه آه
همه راهام رو به تو
وقتی می‌خندی
شهرْ قشنگ‌تر میشه
حتی سکوت
یه آهنگ تازه میشه
کنار تو
همه چیز ممکنه
حتی رویاها
واقعی‌تر از همیشه
من و تو
مثل همون مداریم
که هی در می‌زنیم
اما از هم دور نیستیم
مثل همون نوری
که تاریکی رو می‌شکونه
مثل همون عشقی
که حد و مرز نمی‌شناسه
اگه دنیا خاموش بشه
تو هنوز روشنمی
اگه راه دور بشه
تو همیشه همسفرمی
هر کجا باشم
ته قلبم معلومه
اسم تو
خونه ی امن دلمه
