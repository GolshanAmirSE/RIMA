بی‌هوا اومدی
همه چی عوض شد
یه نگاه ساده
دلمو بلد شد
قبل تو این شهر
سرد و بی‌صدا بود
هر چی می‌خندیدم
یه چیزی کم داشت
تو رسیدی آروم
بی‌خبر، بین شون
مثل یه آهنگ
رفت توی جونم
من نمی‌خواستم عاشق شم
ولی دلم کوتاه اومد
تو یه لحظه از راه رسیدی
همه دنیا جا به جا شد
بی‌هوا، بی‌هوا
دل من رفت سمت چشات
بی‌صدا، بی‌صدا
گم شدم توی هوات
تو همونی که می‌خواستم
ولی اسمتو نمی‌دونستم
تو همونی که یه عمره
توی خوابام می‌دیدم
آه آه آه
تو شدی حال خوبم
آه آه آه
تو شدی آرزوم
آه آه آه
دل من با تو می‌رقصه
آه آه آه
نرو از روبروم
با تو دلم هر روز
پر از رؤیاست
حتی تنهاییم هم
با تو قشنگ‌تره
با اینکه نیستیم ولی
همه چی معلومه
بین من و تو
یه حس بی‌مرزه
دستامو بگیر
نه برای همیشه
فقط همین امشب
که دلم پر می‌کشه
من نمی‌خواستم عاشق شم
ولی دلم کوتاه اومد
تو یه لحظه از راه رسیدی
همه دنیا جا به جا شد
بی‌هوا، بی‌هوا
دل من رفت سمت چشات
بی‌صدا، بی‌صدا
گم شدم توی هوات
تو همونی که می‌خواستم
ولی اسمتو نمی‌دونستم
تو همونی که یه عمره
توی خوابام می‌دیدم
بیا نزدیک‌تر
شب هنوز جوونه
دلم با تو امشب
دنیا رو می‌خونه
بیا نزدیک‌تر
بی‌خیال فردا
همین یه لحظه بسه
واسه من و تو، حالا
اگه عشق یعنی
یه حس بی‌دلیل
اگه عشق یعنی
چشمات توی مسیر
پس من عاشق شدم
بی‌خبر، بی‌صدا
تو شدی قصه‌ی من
تو همین ثانیه‌ها
بی‌هوا، بی‌هوا
دل من رفت سمت چشات
بی‌صدا، بی‌صدا
گم شدم توی هوات
تو همونی که می‌خواستم
ولی اسمتو نمی‌دونستم
تو همونی که یه عمره
توی خوابام می‌دیدم
بی‌هوا اومدی
همه چی عوض شد
یه نگاه ساده
دلمو بلد شد
